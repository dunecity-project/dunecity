# ============================================================================
# GENERAL AI BEHAVIOR
# ============================================================================
#
# Global settings that affect all difficulty levels.
#
# AttackTimerMs          - Time between attack checks (milliseconds)
# AttackThresholdPercent - Don't attack until military reaches this % of limit (0.0-1.0)
# MinMoneyForProduction  - Minimum money needed to queue production

[General Behavior]
AttackTimerMs=90000
AttackThresholdPercent=0.40
MinMoneyForProduction=500
# Captured enemy workers cash in at half capacity or T-10s (with cargo).
# QuantBot only; respects human orders and other unit roles. Multiplayer-hashed.
DeviatedHarvesterEarlyReturn=true

# Experimental research-aware economy/logistics; off by default (mirror stalemates).
# Opt-in is 1v1 only (two occupied opposing initial houses) and requires Research Lab.
# Generated lane assumptions additionally require the CivWars map marker. Multiplayer-hashed.
[Civ Wars]
Strategy=false

# ============================================================================
# OPTIONAL MATCH TECHNOLOGY
# ============================================================================
# ResearchLab is hashed for multiplayer and defaults on even when this key is
# absent. It only acts when the match's Research Lab game option is enabled.
# Basic income, power, defence and accepted production commitments keep their funding first.
[Force Concentration]
# r3831-w151 is one seven-gene treatment with the two original-map scopes below.
# Explicit same-source control/candidate overlays are in tests/ai/play-styles/release-r3831-*.ini.
Converge=false
FinishWhenLeading=false
OpeningReadiness=false
PressOn=true
TurretPriority=true
# Palace trials, Custom Hard/Brutal with immutable initial spice; 0 preserves native.
# Target: 1 economy clusters; 2 economy or army by true purchase value.
# Timing: 1 hunting wave; 2 engaged wave. Bounded release every 60/120 seconds.
PalaceValueTarget=0
PalaceWaveTiming=0
# Combat target experiments: 0 preserves native targeting and config hash.
# Focus 1: lowest HP with 75% switch hysteresis; 2: strict lowest HP.
# Priority 1: artillery/rocket infantry first; 2: harvesters before artillery.
FocusFireLevel=0
TargetPriorityLevel=0
# Independent vanilla multi-enemy tuning; inert in 1v1, two-team matches, cities and campaigns.
VanillaFfaWeakestTarget=0
VanillaFfaNearbyTarget=0
VanillaFfaReserve=0
VanillaFfaFullWaves=0
VanillaFfaStarportAfterWave=0
# Starport experiments: 0=native; Buying 1=80%,2=100% factory-price ceiling.
# Stockpile 1/2 retains the price of one/two factory units for a cheaper window.
# EconomyPriority 1=workers before transport,2=also the economy planner's MCV.
StarportBuying=0
StarportCashStockpile=0
StarportEconomyPriority=0
# Replacement production is scoped to vanilla FFA with at least five original players.
VanillaFfaThreatProduction=0
VanillaFfaSingleFront=0
VanillaFfaLightWorkingCash=0
# Optional IX/Palace deferral is scoped to vanilla FFA with at least five original players.
VanillaFfaFundedTech=0
# Fixed vanilla spice-boom families; all OFF and never used in no-spice or asymmetric survival games.
# Harvester-heavy: 8/12 workers, two refineries, normal military; refinery-wide: 4/6 bays, two workers/bay.
# Greedy: 16 workers / 6 refineries until 6/10/12 min, then all optional growth cash goes to army until 20 min.
# Reactive: true-state reachable-army and economic-size ratios, with immediate near-base army conversion.
# Existing accepted queues are not cancelled. The test styles scope every family to FFA.
VanillaHarvesterBoom=0
VanillaRefineryBoom=0
VanillaGreedyBoom=0
VanillaReactiveBoom=0
VanillaBoomFfaOnly=0
# Default-OFF reachable-spice gate for the refinery/harvester openings; fixed levels 4000/8000.
VanillaBoomSpiceGate=0
VanillaBoomSpicePerRefinery=4000
; Autonomous Custom duels only: 0 native, 1 second refinery, 2 (default) light harvester raid (DuneCity only), 3 first heavy factory.
DuelOpeningPlan=2
VanillaHarvesterBoomWorkers=8
VanillaRefineryBoomRefineries=4
VanillaGreedyBoomMinutes=6
VanillaReactiveArmyRatioBps=6000
VanillaReactiveEconomyRatioBps=12000
# Independent Custom Brutal Vanilla FFA experiments: original occupied FFA4/6, no allies, spice > 0.
# Threat and blend have only two fixed levels: 5000 (50%) or 10000 (100%). Neither enables boom.
VanillaCoreDefence=0
VanillaCoreDefenceThreatBps=5000
VanillaArmyCounters=1
VanillaArmyCounterBlendBps=5000
# Vanilla/DuneCity FFA4/FFA6 vulture: 0 native, 1 rival <60%, 2 rival <90% of strike force.
# Mutual current ground-unit combat replaces rolling history; no save-format change.
FfaVultureLevel=0
# Custom Vanilla/DuneCity teams only; the styled seat coordinates its allied QuantBot's waves.
TeamSynchroniseAttacks=0
# Ally-base rescue as a percent of ground army HP value: 0 (native), 25, or 50.
TeamDefenceSharePercent=0
# Experimental custom spice Vanilla/DuneCity games: 0=native, 1=income/min >= tech cost,
# 2=income/min >= 2*tech cost. Safe full-knowledge rivals allow earlier tech.
TechIncomeTiming=0
# Use Full campaign QuantBot policy for Single mission and Single mission co-op.
# Hashed; OFF restores legacy Single behavior. Full campaign policy is unchanged.
SingleMissionCampaignPolicy=true
# Treat the selected campaign player house as player-side without a registered human.
# OFF preserves the old human-presence role test; authored enemy houses are unchanged.
CampaignPlayerHouse=0
# Establish campaign player-side combat production before repeat refinery expansion.
# Hashed; OFF preserves the economy-first opening.
CampaignMilitaryOpening=1
# Size classic campaign player-side readiness to enemy strength without a fifteen-minute delay.
# Hashed; OFF preserves the old fixed opening threshold. City campaigns are unchanged.
CampaignAdaptiveReadiness=1
# A campaign player-side house holds its ground waves until its army matches the strongest
# opposing alliance (capped at 75% of its own limit). Hashed; OFF preserves the difficulty
# threshold alone. City campaigns are unchanged.
CampaignAllyStrengthFloor=1
# On a quota mission a campaign helper sharing the player's house stops placing orders once the
# house has banked half its quota, or once the map holds less than three times the spice still
# needed, so the mission can be won on credits. Hashed; OFF retains unrestricted spending.
# City campaigns are unchanged.
CampaignHelperQuotaSaving=1
# The three difficulty levers of Easy / Medium / Hard campaign opponents (Brutal has none). Hashed.
# Harvesters: the most an opponent keeps, however many refineries the mission gives it (0 = no ceiling).
CampaignEasyHarvesters=1
CampaignMediumHarvesters=2
CampaignHardHarvesters=4
# WaveValue: the value one ground wave may hold. Easy keeps its smaller early-mission waves in
# proportion (900 / 1,200 of 1,700).
CampaignEasyWaveValue=1700
CampaignMediumWaveValue=2500
CampaignHardWaveValue=3500
# OpeningDelaySec: seconds waited after the map's first enemy combat reinforcement (plus a 0-2 minute
# per-house stagger) before the first wave. Missions 1-4 have no such trigger and always open in minutes 4-6.
CampaignEasyOpeningDelaySec=0
CampaignMediumOpeningDelaySec=0
CampaignHardOpeningDelaySec=60
# The levers of a campaign helper (a QuantBot on the player's side in a campaign), by its difficulty. Hashed.
# Harvesters: the most it keeps (0 = the spice budget alone).
CampaignHelperEasyHarvesters=4
CampaignHelperMediumHarvesters=6
CampaignHelperHardHarvesters=8
CampaignHelperBrutalHarvesters=0
# ArmyFloor: until its ground army holds this value, and once it has two refineries, it funds
# ground production before its economy (0 = economy first).
CampaignHelperEasyArmyFloor=0
CampaignHelperMediumArmyFloor=0
CampaignHelperHardArmyFloor=3000
CampaignHelperBrutalArmyFloor=6000
# Fund campaign player-side ground production before economic savings during live base attacks.
# Hashed; real prices, military budgets and unit limits stay unchanged.
CampaignThreatProduction=1
# Campaign opening Light Factories wait until the first unit and protected cash are funded.
CampaignFundedLightOpening=1
# Before heavy-factory technology, fund campaign light growth from real uncommitted cash.
CampaignLightWorkingCash=1
# Protect a second refinery's founded quote from low-tech light units until it is queued.
CampaignLightIncomeSeed=1
# Round-2 classic campaign AI support: accepted idle-cash factory ON; other candidates remain OFF.
# Build the first vehicle factory before the Starport's optional import infrastructure.
CampaignFactoryBeforeStarport=0
# Spend 2,000 uncommitted credits on the first vehicle factory; 63W/3L, all62 prior wins kept.
CampaignIdleCashFactory=1
CampaignIdleCashFactoryCredits=2000
# Reuse base-defence assignments at attacked refineries; fund lost processing bays before growth.
CampaignRefineryDefence=0
# Save the full first Light Factory/foundation/unit runway before optional extra refineries.
CampaignFactoryRunway=0
# Initially spice-bearing campaign AI support below Heavy Factory tech only.
# Harvest jobs: 0=OFF, 1=home side of enemy-base frontier, 2 (default)=four tiles inward.
CampaignHomeFields=2
# Campaign support, positive initial spice, actual ground attack on a live worker only.
# Reuse sized rescue: 0=OFF, 1=require 100% threat coverage, 2=require 150%; buildings unchanged.
CampaignSizedWorkerRescue=0
# Campaign support with a Starport builds its first Heavy Factory only after its first Repair
# Yard, and only once the Starport has no tank, siege tank or launcher in stock at or below list
# price (or cash is above 2,500): the Starport supplies the early army. Hashed; OFF builds the
# Heavy Factory as soon as it is chosen. City campaigns are unchanged.
CampaignHelperFactoryLast=1
# Campaign support troops that are not out with an attack wave do not chase a target, or answer a
# ground contact, more than this many tiles from the nearest building the house owns; they return
# to their assembly point. 0=OFF. Hashed.
CampaignHelperDefenceLeash=14
# Campaign support lays no concrete, except under Light and Heavy Factories, the High-Tech Factory,
# WOR and Barracks (CampaignHelperFactoryConcrete): a producer on bare rock starts at half health
# and builds at half speed. Hashed; OFF lays concrete under every building.
CampaignHelperNoConcrete=1
CampaignHelperFactoryConcrete=1
# Campaign support with a Starport available builds this many refineries before the Starport, and
# grows to the refinery goal once its Repair Yard stands, both bounded by the map's spice; it
# plans 1.75 harvesters per refinery and keeps one carryall per CarryallRatio harvesters.
# 0=OFF for each. Hashed.
CampaignHelperOpeningRefineries=6
CampaignHelperRefineryGoal=8
CampaignHelperCarryallRatio=2
# Campaign support upgrades its Construction Yard once its first Light Factory stands, outside the
# deferred spare-cash rule (0=OFF, 1=as soon as affordable, 2=after Light Factory, 3=after Heavy
# Factory, 4=after Heavy Factory and the full harvester fleet). Hashed.
CampaignHelperYardUpgradeTiming=2
# Campaign support at the ground unit limit attacks with the army it has when that army is below its
# readiness: the strength floor can otherwise ask for more than the unit cap can hold. Hashed.
CampaignHelperUnitCapLaunch=1
# Custom and skirmish QuantBots playing vanilla power rules buy the windtraps that close a power
# shortage when its running cost (repairs plus the refinery pay a damaged refinery loses) repays
# them within this many game minutes, ordering them only when the yard has nothing else to build.
# 0=OFF. Hashed.
VanillaPowerPayback=25
ResearchLab=1
# Research is a technology prerequisite, not optional expansion after the opening fleet.
# Hashed OFF/ON control; the match Research Lab option and normal human legality still apply.
ResearchLabProgression=1
# Fund a legal generator before demanded city growth loses its power headroom.
# Military production and Starport bargains may spend only the remaining cash.
CityGrowthPower=1
# Size city reserve generation without consuming the seed town's working capital.
CityPowerSizing=1
# Preserve a tax-dependent seed town's existing four-minute working capital.
# Viable spice economies retain normal budgets; only optional MCVs/producer upgrades are gated.
# Military production and required power/supply are unchanged.
CityOpeningCapital=1
# Hard/Brutal: protect a seeded tax city's already affordable first Heavy Factory.
# Below-quote saving requires the separate opt-in CityFirstFactorySaving.
CityConstructionCapital=1
# Reserve the first missing production prerequisite, not the factory it unlocks.
# Standing or queued suppliers do not reserve another speculative plot.
CityProductionPrerequisites=1
# Experimental: below-quote first-HF saving in seeded Hard/Brutal multi-yard tax cities.
# Requires forecast net income covering the founded quote plus queued debt.
# Default off: the combined geometry/saving trial failed combat and ladder gates.
CityFirstFactorySaving=0
# Experimental: direct base attacks keep military capital ahead of ordinary city growth.
CityThreatBudget=0
# Experimental: extend bounded reactive ground cover to city zones, not just the core.
CityZoneDefence=0
# Experimental: fund the first high-tech IX/prerequisite before repeatable capacity.
CityAdvancedTech=0
# Experimental: keep city research funded after the opening fleet reaches its target.
CityContinuousResearch=0
# Research order: 0 native; 1 intended-unit technology ceiling; 2 (default) also defer new research until income covers it.
CityResearchOrder=2
# Experimental: stop extra spice capacity when the existing fleet can deplete its share.
CitySpiceTransition=0
# Experimental: local spice/refinery threshold for a guarded field outpost (0, 4000, 8000).
SpiceFieldExpansion=0
# Experimental: preserve working-capital runway for optional spice-city MCVs/upgrades.
CitySpiceCapacityRunway=0
# Experimental: give a single yard profitable RCI growth after ordinary infrastructure.
CitySingleYardGrowth=0
# Experimental: cash-constrained spice cities reserve bounded latent zone growth power.
CityPowerGrowthHorizon=0
# Experimental coherent boom families: spice-backed Custom city FFA with 5+ occupied controllers.
# All are OFF; never selected by map name, mission, seed, live house count or fog.
CityBoomWorkers=0
CityBoomRefineries=0
CityBoomGreedy=0
CityBoomShortTax=0
CityBoomReactive=0
# Worker-heavy uses 16/24 workers on two bays; refinery-wide uses 6/10 bays and two workers per bay.
CityBoomWorkerGoal=16
CityBoomRefineryGoal=6
# Greedy and low-tax openings stop at 6/10 minutes; low tax is 3%, then normal 7%.
CityBoomGreedyMinutes=6
CityBoomTaxMinutes=6
# Full-knowledge reactive boom: army/strongest reachable army 0.6/0.9; economy/leader 1.2/1.5.
CityBoomArmyRatioBps=6000
CityBoomEconomyRatioBps=12000
# Spice gate for every boom family (all OFF): boom only while the house's reachable, apportioned
# spice pays each planned worker/bay back within 10/15 minutes and beats city tax payback.
CityBoomSpiceGate=0
CityBoomPaybackMinutes=10
# City FFA (4+ occupied controllers) harvester efficiency, all OFF:
# nearest uncontested spice avoiding true hostile armies within 6/10 tiles;
CityHarvestFieldChoice=0
CityHarvestFieldSafetyTiles=6
# refineries sited by own spice within 8/12 tiles, with returns spread across bays;
CityRefineryLogistics=0
CityRefinerySiteTiles=8
# lost workers replaced first while apportioned spice pays back within 10/15 minutes.
CityHarvesterReplacement=0
CityHarvesterReplacementMinutes=10
# City FFA services (OFF): police land-value siting/funding at 60/100%; growth-stage tax
# 3% below 3000/6000 displayed population, normal 7% at/above it.
CityLandValueServices=0
CityLandValueFundingPercent=60
CityGrowthStageTax=0
CityGrowthTaxPopulation=3000
# Batch3 City economy experiments (0 = OFF; 1/2 = levels). DuneCity Custom skirmish on a map
# that starts with spice only: Vanilla, campaigns, Civilization Wars, no-spice maps inert.
# Income-paced producer technology (research-enabled only), 1x/2x income per minute (default 2):
CityCapitalPacing=2
# Fleet ratio targets (Hard/Brutal): 1 = 3 workers/bay, 1 carryall/4 workers, 1 repair yard; 2 = 4 workers/bay.
CityFleetRatios=0
# Optional producer technology waits for 3/5 refinery bays (never above the spice plan).
CityTechRefineries=0
# An optional extra yard (capacity MCV) waits for 3/5 refinery bays (never above the spice plan).
CityYardRefineries=0
# Lost workers replaced first, any roster, while spice per worker pays back in 10/15 minutes.
CityWorkerReplacement=0
# Map-scoped repairs (OFF; 1/2 = levels), measured on the original explicit map grid; unknown
# and initially spiceless maps are never scoped. Native PressOn, FinishWhenLeading and
# JoinAllyWaves where mountain is at least 8%/6% of the tiles:
ClosingMountainScope=0
# Native Converge on measured, spice-bearing maps with exactly 2 original occupied controller rows,
# area at most 4,096 tiles (not a per-dimension limit), and at least 8% mountain (default 1; 0 = OFF):
ConvergeChokepointScope=1
# Native OpeningReadiness with at least 4 original occupied controller rows, below 1.1% mountain,
# and below 20% thick spice or positive rock with rock contiguity below 0.45; measured, spice-bearing only:
OpeningOpenMapScope=1
# VanillaArmyCounters inert below 20% thick spice (1), or also below 0.45 rock contiguity (2);
# by the original roster instead: inert against at least 3 (3) / 5 (4) opposing sides; 5 = 4 or 1:
VanillaArmyCounterMapScope=5
# Native FocusFireLevel on maps of at least 192x192 (1), or also below 1000 tiles per player (2);
# by the original roster instead: native against at least 3 (3) / 5 (4) opposing sides; 5 = 3 or 1:
FocusFireMapScope=0
# Spice bloom harvest (default 1; 0 = OFF, 2 = low-spice threshold): a cheap idle ranged unit fires at an explored bloom
# near our refineries and on our side, never wasting one while the known spice within 7 tiles
# exceeds none (1) / 2000 (2). Custom skirmish only; campaigns, Civilization Wars and
# human-allied houses stay unchanged.
SpiceBloomHarvest=1
# Experimental: true-force retreat, early vehicle repair and threatened-field evacuation.
# Vanilla/DuneCity skirmish only; campaigns and human-allied helpers stay unchanged.
RetreatPreserve=0
# 1: retreat at enemy >= 1.5x friendly local strength; 2: at >= 2x.
RetreatPreserveLevel=1
# Experimental: shared fast-unit harvester raids in Custom skirmish; campaigns stay inert.
HarvesterRaid=0
# 1: two units vs the richest-income rival's workers/refineries; 2: four vs an unprotected worker.
HarvesterRaidLevel=1
# Bounded rocket cover against observed ground raids, ahead of routine growth.
ThreatTurrets=1
# Experimental 3-rocket baseline (4 for Hard+ at 16 structures), with a full income budget.
# Denser observed-ground cover (175 value/rocket), still 2-8 locally and 12 reactive total.
# Default off: the final paired trial did not meet the +1 rocket/house acceptance gate.
MoreRocketTurrets=0
# Stefan, 2026-11-23: "also make the ai respond when being bombed by planes by having more turrets
# dispersed". While city airplane bombs land on a house's buildings, and for three game minutes
# after the last one, it adds Rocket Turrets spread through its city: beside a building with no own
# Rocket Turret within 8 tiles, first near the bomb hits, at least 6 tiles from the other Rocket
# Turrets. At most 2 a minute, 8 a raid and 24 Rocket Turrets in all; bought only from cash above
# the build pass's largest reserve plus 500, and only when the house can power it. 0 = off.
AirRaidTurrets=1
# Stefan, 2026-11-27: "also allow ai to build buildings right up to enemy buildings". 1 (protocol 141):
# an enemy building on a site's border costs the site nothing (it was -10 a tile), and a site under
# light enemy fire (one weapon's reach) is taken after every safe site instead of refused; heavy fire
# (two weapons or more) still waits for a held finished building's minute. 0 = the spacing before 141
# (play style @old-enemy-spacing, for experiment arms).
BuildUpToEnemy=1
# Stefan, 2026-11-27: the Fremen Palace calls a worm (match rule Fremen Palace Worm). 1: it hunts an enemy
# army standing on its sand and bursts into spice near our refineries when there is none (or before it
# would leave unused); 0: it bursts for spice at once; 2: it only hunts (play styles @palace-worm-0/-2).
PalaceWorm=1
# Stefan, 2026-11-24: "on skirmish with fully built base the ai doesn't build rocket turret defenes
# and everyones base gets steamrolled by a plane". As soon as another team has an Airport or has
# flown a city airplane (and bombing is on), a house spreads Rocket Turrets through its city by the
# AirRaidTurrets coverage rule before the first bomb lands: one a minute, until it has 16 Rocket
# Turrets. With this on, these turrets and the ones against a raid are paid ahead of strategic and
# civic savings; only the economy's reserve must remain. 0 = off (AirRaidTurrets as it was).
# Default off: in 48 paired matches the houses ordered 21 such turrets a game instead of 1.6 and
# lost the same buildings to bombs (+4 a game, -14 to +23).
AirThreatTurrets=0
# Stefan, 2026-11-26: "also airports need decent rocket turret defenses". Every own Airport keeps
# 4 Rocket Turrets (standing and queued) within 5 tiles of its footprint, spread round it, and a
# lost one is ordered again; one order a build pass, from cash beyond the economy's reserve, never
# saved for. City games with City Plane Bombing only. 0 = off.
# Default off: in 48 paired matches the ring filled (93% of Airports by minute 20 against 65%) but
# bombs destroyed the same Airports (1.04 a game against 1.10); level on placement in 288 mixed games.
AirportTurrets=0
# Stefan, 2026-11-27: Hospitals heal infantry (match rule Hospital Care). With this on, a QuantBot
# soldier below 60% health goes to the nearest own Hospital with a free bed once no armed enemy has
# been within weapon reach of it for 500 cycles (about 8 s); 6+ tiles away it also asks for a
# Carryall. It is reserved until healed. 0 = off: AI infantry are never sent to a Hospital.
# Default off: level in two 288-game mixed screens. Sent under fire (onDamage): on - off -0.017
# (-0.09..+0.06), 637 of 891 trips a game died on the way. Out of contact only: -0.005
# (-0.09..+0.07), 55 of 64 trips a game healed.
HospitalInfantry=0
# Stefan, 2026-11-27: Rocket Turrets at the front (include/players/TurretFrontPolicy.h). All off
# until measured. A Rocket Turret costs 15 credits a city year of police upkeep (7.5 a minute with
# Slow City Year), so a turret pays only while something is in its range.
# FrontTurrets: an attacked building cluster gets turrets until its cover matches the attack.
FrontTurrets=0
# AdvancingTurrets: a belt of turrets at the base's enemy-facing edge, moved forward behind the army.
AdvancingTurrets=0
# TurretCreep: turrets within range of enemy buildings where at most one enemy turret reaches.
TurretCreep=0
# RearTurretRetire: turrets far from every enemy are sold (demolished where selling is off), four
# every two minutes, keeping the base's own coverage need.
RearTurretRetire=0
# TurretDrill: once the base's edge stands within 24 tiles of an enemy building, a dense mass of
# Rocket Turrets is built straight toward and into that base, as close as each yard can place it,
# for as long as cash beyond the economy's reserve lasts (no count cap). Stefan, 2026-11-27: "i just
# build turrets into their base as a mass and they carved a hole in the ebemy base" (TurretFrontPolicy.h).
TurretDrill=0
# EconomyFirst: on a low or no spice map (below 20,000 spice per living house) a city house builds its economy
# first, as Stefan did on his Air map: Construction Yards on his schedule (4, 6 from minute 15, 9 from 20),
# factories leave 10,000 credits for the yards unless an enemy is at the base, the Starport buys nothing, and an
# idle yard zones in his R/C/I mix, until the city has 6,734 people (CityLessonsPolicy.h).
EconomyFirst=0
# Stefan, 2026-11-26: "the airport economic value should be factored in by the ai to determine if
# it makes sense to buy more airports". Another Airport (up to 4) when this house's planes have
# destroyed enough per flight for that Airport's free planes to repay its price within 20 minutes
# (CityAircraft::extraAirportPays), from spare cash only: each Airport has its own free plane (City Plane
# Free Per Airport) and builds one bought plane at a time (City Plane Build Time; counted while every
# Airport is busy). A rich house (30,000 beyond its reserves and the Airport's price) with every
# Airport building orders more, up to 8, whatever the payback. 0 = off.
ExtraAirports=1
# Save a solvent city's first useful Starport instead of zoning its price away.
CityStarportSupply=1
# Forecast earned-income overflow after useful production, including T1 refinery vaults.
# Bound storage projects to one in flight and the absolute credit ceiling.
StorageCapacity=1
# Opt-in power/storage discipline: 0 preserves the native decisions and hash.
# Lead wind generation by 1 or 2 selected consumer buildings (raw power also prevents decay).
PowerLeadBuildings=0
# Earned-credit occupancy backstop: 0 native forecast, or a Silo at 80/90 percent.
# Both research controls stay inert when no map spice remains.
SiloFillPercent=0
# Fund Custom Brutal powered non-city production with the established spice policy.
# Campaigns, engine power requirements and unit-mix learning are unchanged.
FundedClassicProduction=1
# DuneCity-content Custom games: WOR rocket infantry for air/armour and army escorts.
# Six standing; reactive air floor up to18. Infantry strategy retains its existing quota.
# ON at Stefan's direction despite unproven adoption/Starport acceptance; see HANDOVER.
TrooperSupport=1
# Zone Garrisons (match rule): Soldiers and Troopers garrison own city zones that enemies close on
# (7 tiles), come out when none is within 11, and take empty enemy zones within 5 tiles of them.
# 0 = QuantBot never uses garrisons. docs/zone-garrisons.md has the OFF/ON evidence.
ZoneGarrison=0
# A free Soldier or Trooper takes each empty enemy zone with no enemy unit or turret near it and
# stays inside (a captured zone returns to its owner once its garrison is gone).
ZoneCaptureRaid=0
# Barracks train a levy of cheap Soldiers that walks into the nearest enemy zones.
ZoneCaptureLevy=0
# House to house (Stefan, 2026-11-27): Troopers reinforce threatened garrisons; our zones nearest the
# enemy get a garrison first; soldiers take the next enemy zone across the street from a zone we hold.
ZoneGarrisonReinforce=0
ZoneFrontGarrison=0
ZoneCaptureChain=0
# Stateless existing-composition/technology experiment; paired outcomes rejected adoption.
# Default OFF. No saved budget, save-format change or protocol change.
SimpleTechSavings=0
# Launchers back off two extra tiles (0 = old spacing, bounded to 0..2).
# Hunt stand-off remains inside firing range; other unit types are unchanged.
LauncherKiteExtraDistance=2
# Custom noncampaign armies release rebuild-only dispatch/repair holds only when
# reachable spice, affordable units, income and pending cargo are all exhausted.
# Manual orders, defence and saboteur ownership are unchanged; 0 keeps legacy holds.
ExhaustedArmyDispatch=1
# Experimental fixed fleet ratios; no effect unless the master switch is on.
# Reachable remaining spice is shared across the originally occupied houses.
# Existing assets and accepted orders are never removed.
EconomicFleetRatios=0
FleetHarvestersPerBay=3
FleetCarryallQuarters=1
FleetRepairYards=1
# Experimental, multiplayer-hashed OFF/ON treatment; shipped policy stays unchanged.
# Custom only: preserve the useful first repair/tech prerequisite, then require
# 30 seconds of reachable local backlog with all usable bays repairing.
# Queued bays, idle bays and transport/access failures do not justify repeats.
# Campaign rebuild permissions and Medium's existing limits are unchanged.
RepairCapacityDemand=false
# Experimental pre-ladder (1.0.807) Custom Medium, default 0 = current. 1: no banked-credit
# surplus army and no heavy-factory walk after the starport opening; 2: also the standing
# 40% raid share instead of whole-army waves. Easy/Hard/Brutal and campaigns are unchanged.
MediumClassic=0
