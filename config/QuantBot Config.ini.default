# ============================================================================
# GENERAL AI BEHAVIOR
# ============================================================================
#
# Global settings that affect all difficulty levels.
#
# AttackTimerMs          - Time between attack checks (milliseconds)
# AttackThresholdPercent - Don't attack until military reaches this % of limit (0.0-1.0)
# MinMoneyForProduction  - Minimum money needed to queue production

[General Behavior]
AttackTimerMs=90000
AttackThresholdPercent=0.40
MinMoneyForProduction=500
# Captured enemy workers cash in at half capacity or T-10s (with cargo).
# QuantBot only; respects human orders and other unit roles. Multiplayer-hashed.
DeviatedHarvesterEarlyReturn=true

# Experimental research-aware economy/logistics; off by default (mirror stalemates).
# Opt-in is 1v1 only (two occupied opposing initial houses) and requires Research Lab.
# Generated lane assumptions additionally require the CivWars map marker. Multiplayer-hashed.
[Civ Wars]
Strategy=false

# ============================================================================
# OPTIONAL MATCH TECHNOLOGY
# ============================================================================
# ResearchLab is hashed for multiplayer and defaults on even when this key is
# absent. It only acts when the match's Research Lab game option is enabled.
# Basic income, power, defence and accepted production commitments keep their funding first.
[Force Concentration]
# Independent vanilla multi-enemy tuning; inert in 1v1, two-team matches, cities and campaigns.
VanillaFfaWeakestTarget=0
VanillaFfaNearbyTarget=0
VanillaFfaReserve=0
VanillaFfaFullWaves=0
VanillaFfaStarportAfterWave=0
# Replacement production is scoped to vanilla FFA with at least five original players.
VanillaFfaThreatProduction=0
VanillaFfaSingleFront=0
VanillaFfaLightWorkingCash=0
# Optional IX/Palace deferral is scoped to vanilla FFA with at least five original players.
VanillaFfaFundedTech=0
# Fixed vanilla spice-boom families; all OFF and never used in no-spice or asymmetric survival games.
# Harvester-heavy: 8/12 workers, two refineries, normal military; refinery-wide: 4/6 bays, two workers/bay.
# Greedy: 16 workers / 6 refineries until 6/10/12 min, then all optional growth cash goes to army until 20 min.
# Reactive: true-state reachable-army and economic-size ratios, with immediate near-base army conversion.
# Existing accepted queues are not cancelled. The test styles scope every family to FFA.
VanillaHarvesterBoom=0
VanillaRefineryBoom=0
VanillaGreedyBoom=0
VanillaReactiveBoom=0
VanillaBoomFfaOnly=0
VanillaHarvesterBoomWorkers=8
VanillaRefineryBoomRefineries=4
VanillaGreedyBoomMinutes=6
VanillaReactiveArmyRatioBps=6000
VanillaReactiveEconomyRatioBps=12000
# Treat the selected campaign player house as player-side without a registered human.
# OFF preserves the old human-presence role test; authored enemy houses are unchanged.
CampaignPlayerHouse=0
# Establish campaign player-side combat production before repeat refinery expansion.
# Hashed; OFF preserves the economy-first opening.
CampaignMilitaryOpening=1
# Size classic campaign player-side readiness to enemy strength without a fifteen-minute delay.
# Hashed; OFF preserves the old fixed opening threshold. City campaigns are unchanged.
CampaignAdaptiveReadiness=1
# Fund campaign player-side ground production before economic savings during live base attacks.
# Hashed; real prices, military budgets and unit limits stay unchanged.
CampaignThreatProduction=1
# Campaign opening Light Factories wait until the first unit and protected cash are funded.
CampaignFundedLightOpening=1
# Before heavy-factory technology, fund campaign light growth from real uncommitted cash.
CampaignLightWorkingCash=1
# Protect a second refinery's founded quote from low-tech light units until it is queued.
CampaignLightIncomeSeed=1
# Round-2 classic campaign AI support: accepted idle-cash factory ON; other candidates remain OFF.
# Build the first vehicle factory before the Starport's optional import infrastructure.
CampaignFactoryBeforeStarport=0
# Spend 2,000 uncommitted credits on the first vehicle factory; 63W/3L, all62 prior wins kept.
CampaignIdleCashFactory=1
CampaignIdleCashFactoryCredits=2000
# Reuse base-defence assignments at attacked refineries; fund lost processing bays before growth.
CampaignRefineryDefence=0
# Save the full first Light Factory/foundation/unit runway before optional extra refineries.
CampaignFactoryRunway=0
ResearchLab=1
# Research is a technology prerequisite, not optional expansion after the opening fleet.
# Hashed OFF/ON control; the match Research Lab option and normal human legality still apply.
ResearchLabProgression=1
# Fund a legal generator before demanded city growth loses its power headroom.
# Military production and Starport bargains may spend only the remaining cash.
CityGrowthPower=1
# Size city reserve generation without consuming the seed town's working capital.
CityPowerSizing=1
# Preserve a tax-dependent seed town's existing four-minute working capital.
# Viable spice economies retain normal budgets; only optional MCVs/producer upgrades are gated.
# Military production and required power/supply are unchanged.
CityOpeningCapital=1
# Hard/Brutal: protect a seeded tax city's already affordable first Heavy Factory.
# Below-quote saving requires the separate opt-in CityFirstFactorySaving.
CityConstructionCapital=1
# Reserve the first missing production prerequisite, not the factory it unlocks.
# Standing or queued suppliers do not reserve another speculative plot.
CityProductionPrerequisites=1
# Experimental: below-quote first-HF saving in seeded Hard/Brutal multi-yard tax cities.
# Requires forecast net income covering the founded quote plus queued debt.
# Default off: the combined geometry/saving trial failed combat and ladder gates.
CityFirstFactorySaving=0
# Experimental: direct base attacks keep military capital ahead of ordinary city growth.
CityThreatBudget=0
# Experimental: extend bounded reactive ground cover to city zones, not just the core.
CityZoneDefence=0
# Experimental: fund the first high-tech IX/prerequisite before repeatable capacity.
CityAdvancedTech=0
# Experimental: keep city research funded after the opening fleet reaches its target.
CityContinuousResearch=0
# Experimental: stop extra spice capacity when the existing fleet can deplete its share.
CitySpiceTransition=0
# Experimental: preserve working-capital runway for optional spice-city MCVs/upgrades.
CitySpiceCapacityRunway=0
# Experimental: give a single yard profitable RCI growth after ordinary infrastructure.
CitySingleYardGrowth=0
# Experimental: cash-constrained spice cities reserve bounded latent zone growth power.
CityPowerGrowthHorizon=0
# Bounded rocket cover against observed ground raids, ahead of routine growth.
ThreatTurrets=1
# Experimental 3-rocket baseline (4 for Hard+ at 16 structures), with a full income budget.
# Denser observed-ground cover (175 value/rocket), still 2-8 locally and 12 reactive total.
# Default off: the final paired trial did not meet the +1 rocket/house acceptance gate.
MoreRocketTurrets=0
# Save a solvent city's first useful Starport instead of zoning its price away.
CityStarportSupply=1
# Forecast earned-income overflow after useful production, including T1 refinery vaults.
# Bound storage projects to one in flight and the absolute credit ceiling.
StorageCapacity=1
# Fund Custom Brutal powered non-city production with the established spice policy.
# Campaigns, engine power requirements and unit-mix learning are unchanged.
FundedClassicProduction=1
# DuneCity-content Custom games: WOR rocket infantry for air/armour and army escorts.
# Six standing; reactive air floor up to18. Infantry strategy retains its existing quota.
# ON at Stefan's direction despite unproven adoption/Starport acceptance; see HANDOVER.
TrooperSupport=1
# Stateless existing-composition/technology experiment; paired outcomes rejected adoption.
# Default OFF. No saved budget, save-format change or protocol change.
SimpleTechSavings=0
# Launchers back off two extra tiles (0 = old spacing, bounded to 0..2).
# Hunt stand-off remains inside firing range; other unit types are unchanged.
LauncherKiteExtraDistance=2
# Custom noncampaign armies release rebuild-only dispatch/repair holds only when
# reachable spice, affordable units, income and pending cargo are all exhausted.
# Manual orders, defence and saboteur ownership are unchanged; 0 keeps legacy holds.
ExhaustedArmyDispatch=1
# Experimental fixed fleet ratios; no effect unless the master switch is on.
# Reachable remaining spice is shared across the originally occupied houses.
# Existing assets and accepted orders are never removed.
EconomicFleetRatios=0
FleetHarvestersPerBay=3
FleetCarryallQuarters=1
FleetRepairYards=1
