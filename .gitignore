# SourceForge credentials (NEVER commit this!)
scripts/sourceforge-config.sh

# Documentation folders (analysis/ is tracked in dunecity)
documents/

# VSCode settings (ignore user-specific, keep shared config)
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
dist/
# Committed browser bundle copied verbatim from the installed p2pkit
# dependency's own build output (tools/web/build-p2pkit-iife.mjs); all other
# dist/ output stays ignored.
!platform/web/dist/
build0/
analysis/
/_CPack_Packages/

# Imported Micropolis sprites — committed so CI doesn't regenerate each build.
# categories/roads/ is NOT ignored — GFXManager loads road tiles from there.
# composites/ (3x3) are intermediate and not needed at runtime.
imported_sprites/micropolis/categories/*/
!imported_sprites/micropolis/categories/roads/
imported_sprites/micropolis/composites/
imported_sprites/micropolis/composites_special/*.broken

# Local-only scratch / editor files
tmp/
*.code-workspace
/Tornie Files

# Python helper caches
__pycache__/
*.py[cod]

# Agent session notes. Codex writes per-version review/analysis scratch into the
# repo root (AI-599-IMPLEMENTATION.md, MULTIPLAYER-553-REVIEW.md, …). These are
# working memory for a single session, not project documentation — the durable
# summary belongs in HANDOVER.md, which IS tracked. See AGENTS.md §Working
# agreement.
/AI-*.md
/*-REVIEW.md
/*-ANALYSIS.md

# The PHP development router is source, not a compiled bin directory.
!tools/p2p-signaling/bin/
!tools/p2p-signaling/bin/router.php

!docs/browser-multiplayer-pr49-validation.md
